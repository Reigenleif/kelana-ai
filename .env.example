APP_NAME=kelana-ai
ENVIRONMENT=development
DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kelana_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kelana_ai

# AWS Bedrock & Knowledge Base Configuration
AWS_BEARER_TOKEN_BEDROCK=foo_token
AWS_REGION=ap-southeast-2
MODEL_ID=amazon.nova-lite-v1:0

# Bedrock Knowledge Base (RAG) configuration
# Connects to S3 bucket holding travel knowledge documents
KNOWLEDGE_BASE_ID=YOUR_BEDROCK_KNOWLEDGE_BASE_ID
KNOWLEDGE_BASE_S3_BUCKET=kelana-s3-127490464453-ap-southeast-2-an

# Optional AWS Credentials if not using default profile or bearer token
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

VITE_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000